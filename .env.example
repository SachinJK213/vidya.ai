# ─── Deployment Mode ────────────────────────────────────────────────────────
# saas | microsaas | onprem
DEPLOYMENT_MODE=saas

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
WEB_URL=http://localhost:5173
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://vidyaai:vidyaai@localhost:5432/vidyaai

# ─── Redis / Queue ───────────────────────────────────────────────────────────
# For on-prem: point at self-hosted Redis or RabbitMQ
REDIS_URL=redis://localhost:6379
# RABBITMQ_URL=amqp://user:pass@localhost:5672  # on-prem alternative

# ─── Storage ─────────────────────────────────────────────────────────────────
# s3 | minio | local
STORAGE_PROVIDER=s3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=vidyaai-uploads
# For on-prem MinIO:
# STORAGE_PROVIDER=minio
# MINIO_ENDPOINT=http://minio:9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=vidyaai-uploads

# ─── Email ───────────────────────────────────────────────────────────────────
# sendgrid | ses | smtp
EMAIL_PROVIDER=smtp
# SENDGRID_API_KEY=
# For SMTP (on-prem Exchange / Postfix / Google Workspace):
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@school.local
# SMTP_AUTH_TYPE=basic  # basic | oauth2 | certificate

# ─── SMS ─────────────────────────────────────────────────────────────────────
# msg91 | twilio | kannel | http_aggregator | disabled
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=VIDYAI
MSG91_DLT_TEMPLATE_IDS={}
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# For on-prem Kannel SMPP:
# SMS_PROVIDER=kannel
# KANNEL_SMPP_HOST=
# KANNEL_SMPP_PORT=2775
# KANNEL_SMPP_USER=
# KANNEL_SMPP_PASS=

# ─── Push Notifications ──────────────────────────────────────────────────────
PUSH_PROVIDER=fcm
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# For on-prem self-hosted FCM proxy:
# PUSH_PROVIDER=fcm_proxy
# FCM_PROXY_URL=http://push-proxy:8080

# ─── AI ──────────────────────────────────────────────────────────────────────
# claude | ollama | disabled
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# For on-prem air-gapped (Ollama):
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=llama3

# ─── Event Bus ───────────────────────────────────────────────────────────────
# redis_streams | kafka | rabbitmq
EVENT_BUS_PROVIDER=redis_streams
# KAFKA_BROKERS=localhost:9092
# RABBITMQ_URL=amqp://user:pass@localhost:5672

# ─── Telemetry ───────────────────────────────────────────────────────────────
# Disabled by default — required for on-prem zero call-home guarantee
TELEMETRY_ENABLED=false
# DATADOG_API_KEY=          # SaaS only
# PROMETHEUS_PORT=9090      # on-prem Prometheus scrape endpoint
